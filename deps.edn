{:paths ["src"]
 ;; babashka/fs is a ClojureScript source input to the shadow-cljs build (it
 ;; becomes lib/nbb_fs.js, upstream #413), not a JVM runtime dependency of
 ;; anything in this workspace. It lives under :bundled so the root guard for
 ;; new top-level JVM deps (ADR-2608201300) reads it as the build-tool coord it
 ;; is; bb.edn's wrap-cmd adds the alias to every shadow-cljs invocation.
 :aliases {:test {:extra-paths ["test"]}
           :bundled {:extra-deps {babashka/fs {:mvn/version "0.5.34"}}}}
 :deps {thheller/shadow-cljs {:mvn/version "3.3.5"}
        #_#_org.clojure/clojurescript {:mvn/version "1.11.51"}
        ;; reagent/reagent {:mvn/version "1.0.0"}
        cljsjs/react {:mvn/version "18.2.0-1"}
        cljsjs/react-dom {:mvn/version "18.2.0-1"}
        cljsjs/react-dom-server {:mvn/version "18.2.0-1"}
        io.nervous/cljs-nodejs-externs {:mvn/version "0.2.0"}
        reagent/reagent {:git/url "https://github.com/borkdude/nbb-reagent"
                         :git/sha "a028c32f35601b68525a20d6cca13bfeae8be39c"}
        funcool/promesa {:mvn/version "11.0.678"}
        applied-science/js-interop {:mvn/version "0.3.3"}
        cljs-bean/cljs-bean {:mvn/version "1.9.0"}
        org.babashka/sci
        {:git/url "https://github.com/babashka/sci"
         :git/sha "6790624776b09297a22100438f05b6555a4ff56d"}
        #_{:mvn/version "0.15.58"}
        org.clojure/tools.cli {:mvn/version "1.0.214"}
        com.cognitect/transit-cljs {:mvn/version "0.8.280"}
        #_#_prismatic/schema {:mvn/version "1.3.0"}
        #_#_metosin/malli {:mvn/version "0.8.8"}
        org.babashka/cli {:mvn/version "0.12.86"}
        io.github.babashka/sci.configs {:git/url "https://github.com/babashka/sci.configs"
                                        :git/sha "a785be2090991bf99ddc1c8cb4923a7217f6e098"}}}
